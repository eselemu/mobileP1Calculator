<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:backgroundTint="#2D2D2D"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="15dp"
        android:background="#FFFFFF"
        android:backgroundTint="#2D2D2D"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:backgroundTint="#A61C1C"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtViewAccumulated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_weight="1"
                    android:textAlignment="viewEnd"
                    android:textColor="#A6A6A6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtViewDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:paddingEnd="15dp"
                    android:paddingBottom="15dp"
                    android:textAlignment="textEnd"
                    android:textColor="#D1D1D1"
                    android:textSize="48sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.12"
            android:orientation="horizontal">

            <Button
                android:id="@+id/butDel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#8B8B8B"
                android:text="DEL"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/butC"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#8B8B8B"
                android:text="C"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/butCE"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#8B8B8B"
                android:text="CE"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/butDiv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#FF7A7A"
                android:text="÷"
                android:textSize="24sp"
                app:cornerRadius="15dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.12"
            android:orientation="horizontal">

            <Button
                android:id="@+id/but07"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#5B5B5B"
                android:onClick="addNumberDisplay"
                android:text="7"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/but08"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#5B5B5B"
                android:onClick="addNumberDisplay"
                android:text="8"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/but09"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#5B5B5B"
                android:onClick="addNumberDisplay"
                android:text="9"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/butMult"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#FF7A7A"
                android:text="x"
                android:textSize="24sp"
                app:cornerRadius="15dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.12"
            android:orientation="horizontal">

            <Button
                android:id="@+id/but04"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#5B5B5B"
                android:onClick="addNumberDisplay"
                android:text="4"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/but05"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#5B5B5B"
                android:onClick="addNumberDisplay"
                android:text="5"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/but06"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#5B5B5B"
                android:onClick="addNumberDisplay"
                android:text="6"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/butMinus"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#FF7A7A"
                android:text="-"
                android:textSize="24sp"
                app:cornerRadius="15dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.12"
            android:orientation="horizontal">

            <Button
                android:id="@+id/but01"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#5B5B5B"
                android:onClick="addNumberDisplay"
                android:text="1"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/but02"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#5B5B5B"
                android:onClick="addNumberDisplay"
                android:text="2"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/but03"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#5B5B5B"
                android:onClick="addNumberDisplay"
                android:text="3"
                android:textSize="24sp"
                app:cornerRadius="15dp" />

            <Button
                android:id="@+id/butPlus"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#FF7A7A"
                android:text="+"
                android:textSize="24sp"
                app:cornerRadius="15dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.12"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/but00"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#5B5B5B"
                    android:onClick="addNumberDisplay"
                    android:text="0"
                    android:textSize="24sp"
                    app:cornerRadius="15dp" />

                <Button
                    android:id="@+id/butPoint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#5B5B5B"
                    android:text="."
                    android:textSize="24sp"
                    app:cornerRadius="15dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/butEquals"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="3dp"
                    android:layout_weight="0.7"
                    android:backgroundTint="#FF7A7A"
                    android:text="="
                    android:textSize="24sp"
                    app:cornerRadius="15dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>